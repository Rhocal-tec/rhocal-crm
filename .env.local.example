# ===== Supabase =====
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role key — só usada pelo Motor de Recompra Preditiva (roda
# server-side sem sessão de usuário). NUNCA expor no client.
SUPABASE_SERVICE_ROLE_KEY=

# ===== Omie ERP (server-side apenas — nunca expor no client) =====
OMIE_APP_KEY=
OMIE_APP_SECRET=

# ===== Cron (Motor de Recompra Preditiva + Mobcall sync) =====
# Protege /api/cron/recompra-preditiva e /api/mobcall/sync — mesmo valor
# precisa estar cadastrado em Environment Variables na Vercel. O Vercel Cron
# manda "Authorization: Bearer $CRON_SECRET" automaticamente.
CRON_SECRET=

# ===== Mobcall (telefonia — server-side apenas, nunca expor no client) =====
# URL base da API (ex: https://api.mobcall.com/v2.2) e a API key usada no
# header X-API-KEY. Usadas por /api/mobcall/click-to-call e /api/mobcall/sync.
MOBCALL_API_URL=
MOBCALL_API_KEY=
