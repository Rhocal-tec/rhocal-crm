# ===== Supabase =====
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role key — só usada pelo Motor de Recompra Preditiva (roda
# server-side sem sessão de usuário). NUNCA expor no client.
SUPABASE_SERVICE_ROLE_KEY=

# ===== Omie ERP (server-side apenas — nunca expor no client) =====
OMIE_APP_KEY=
OMIE_APP_SECRET=

# ===== Cron (Motor de Recompra Preditiva) =====
# Protege /api/cron/recompra-preditiva — mesmo valor precisa estar cadastrado
# em Environment Variables na Vercel.
CRON_SECRET=
